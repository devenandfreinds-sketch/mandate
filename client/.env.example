# Copy this to client/.env.local for local development. Not needed locally — the Vite dev server
# proxies /api to localhost:3001 (see vite.config.ts), so client and server are same-origin.
#
# Required in production ONLY when the client is deployed as its own service, separate from the
# server (e.g. two Railway services). Set to the server's public URL, no trailing slash. This is a
# BUILD-TIME variable — Vite bakes it into the JS bundle, so it must be set before `npm run build`,
# not just at runtime/start.
VITE_API_URL=https://mandate-server.up.railway.app
