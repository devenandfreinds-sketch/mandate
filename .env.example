# Copy this to server/.env for local development.
# Local dev: native PostgreSQL (installed via Homebrew), no password (trust auth).
DATABASE_URL="postgresql://<your-macos-username>@localhost:5432/mandate_dev?schema=public"

# Production (e.g. Railway's managed Postgres): swap this value only, no code changes needed.
# DATABASE_URL="postgresql://<user>:<password>@<host>:<port>/<database>?schema=public&sslmode=require"

PORT=3001
NODE_ENV=development

# Admin auth (see `npm run admin:set-password -w server -- <password>`, which writes both of these).
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Restricts CORS + the admin session cookie to this origin. Required in production when the client
# is deployed as a separate service (e.g. Railway) from a different origin than the API.
# Leave unset locally — the Vite dev proxy makes client and server same-origin.
CLIENT_URL=
