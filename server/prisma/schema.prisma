generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================================================
// RESEARCHER IDENTITY (minimal, deliberately not a full account/login system
// per person — see docs/MANDATE_OPERATING_SYSTEM.md). Exists to give
// attribution, review-routing, and the researcher certification ladder a
// real foreign key to point at, instead of the free-text
// ResearchTask.assignedResearcher string. Authentication itself is still the
// single shared admin credential (server/src/middleware/adminAuth.ts) --
// a User row identifies WHO is acting, not a separate login/password.
// =========================================================

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  // Affiliation is WHO this person is to the organization (continuity vs. outside challenge);
  // role is WHAT they're capable of doing. The two are independent -- see docs/MANDATE_RESEARCH_NETWORK.md,
  // "The Critical Distinction". Most external contributors never get a User row at all (see
  // ExternalContribution.contributorName/Email below, used for one-off/unaffiliated submissions);
  // this field is for the smaller set of recurring external participants worth tracking on the roster.
  affiliation        String   @default("internal") // internal | external
  role               String   @default("researcher") // researcher | reviewer | jurisdiction_lead | methodology_lead | admin | advisor | practitioner | contributor
  certificationLevel String   @default("new_researcher") // new_researcher | certified_researcher | senior_researcher | research_lead | methodology_reviewer
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  assignedResearchTasks           ResearchTask[]         @relation("AssignedResearcher")
  reviewingResearchTasks          ResearchTask[]         @relation("ReviewerOnTask")
  researchedMetricValues          MetricValue[]          @relation("ResearchedByOnMetricValue")
  reviewedMetricValues            MetricValue[]          @relation("ReviewedByOnMetricValue")
  researchedPipelineAssessments   PipelineAssessment[]   @relation("ResearchedByOnAssessment")
  reviewedPipelineAssessments     PipelineAssessment[]   @relation("ReviewedByOnAssessment")
  submittedExternalContributions  ExternalContribution[] @relation("ContributorOnExternalContribution")
  reviewedExternalContributions   ExternalContribution[] @relation("ReviewerOnExternalContribution")

  @@index([role])
  @@index([affiliation])
}

// =========================================================
// CORE HIERARCHY: GovernanceModel -> Jurisdiction -> Administration
// =========================================================

model GovernanceModel {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  shortName        String?
  summary          String
  overview         String
  history          String
  politicalContext String
  foundedYear      Int?
  colorHex         String?
  isPlaceholder    Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  jurisdictions  Jurisdiction[]
  corePriorities CorePriority[]
  timelineEvents TimelineEvent[]
}

model CorePriority {
  id                String  @id @default(cuid())
  governanceModelId String
  title             String
  description       String
  sortOrder         Int     @default(0)
  isPlaceholder     Boolean @default(true)

  governanceModel GovernanceModel @relation(fields: [governanceModelId], references: [id], onDelete: Cascade)

  @@index([governanceModelId])
}

model Jurisdiction {
  id                String   @id @default(cuid())
  governanceModelId String
  slug              String   @unique
  name              String
  kind              String // "city" | "metro_region" (data-driven, not enum)
  // Self-relation for metro-region -> constituent-borough (or country -> region -> municipality)
  // hierarchies -- see docs/JURISDICTION_HIERARCHY.md. NULL means "no parent modeled" (true of every
  // jurisdiction today: Greater Manchester is one flat metro_region row, not ten boroughs under it).
  // A jurisdiction's OWN metrics/pipelines are unaffected by whether it has a parent or children --
  // this is purely an optional hierarchy annotation, not a rollup/aggregation mechanism. Nothing
  // currently reads this field; it exists so a future pass can model sub-jurisdictions additively,
  // without a schema change, the day real borough-level research actually needs it.
  parentJurisdictionId String?
  // Free-text administrative-level label ("municipality" | "metro_region" | "borough" | "district" |
  // "region" | "country", data-driven like `kind`) -- deliberately NOT a fixed enum, since countries'
  // administrative structures vary too much for one universal ladder (see docs/JURISDICTION_HIERARCHY.md,
  // "Do not assume every country follows this structure"). NULL means "not yet classified."
  administrativeLevel String?
  stateOrRegion     String?
  country           String
  population        Int?
  populationYear    Int?
  latitude          Float?
  longitude         Float?
  summary           String
  description       String
  isPlaceholder     Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  governanceModel       GovernanceModel        @relation(fields: [governanceModelId], references: [id], onDelete: Restrict)
  parentJurisdiction    Jurisdiction?          @relation("JurisdictionHierarchy", fields: [parentJurisdictionId], references: [id], onDelete: SetNull)
  childJurisdictions    Jurisdiction[]         @relation("JurisdictionHierarchy")
  administrations       Administration[]
  metricValues          MetricValue[]
  timelineEvents        TimelineEvent[]
  pipelineAssessments   PipelineAssessment[]
  researchTasks         ResearchTask[]
  externalContributions ExternalContribution[]

  @@index([governanceModelId])
  @@index([parentJurisdictionId])
}

model Administration {
  id                   String    @id @default(cuid())
  jurisdictionId       String
  leaderName           String
  leaderTitle          String // "Mayor", "Metro Mayor" (data-driven)
  politicalParty       String?
  coalitionDescription String?
  termNumber           Int?
  startDate            DateTime
  endDate              DateTime?
  photoUrl             String?
  isPlaceholder        Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  jurisdiction        Jurisdiction         @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
  campaignPromises    CampaignPromise[]
  metricValues        MetricValue[]
  timelineEvents      TimelineEvent[]
  pipelineAssessments PipelineAssessment[]

  @@index([jurisdictionId, startDate])
}

model CampaignPromise {
  id               String    @id @default(cuid())
  administrationId String
  categoryId       String?
  title            String
  description      String
  status           String // "proposed" | "in_progress" | "fulfilled" | "broken" | "stalled"
  datePromised     DateTime?
  isPlaceholder    Boolean   @default(true)

  administration Administration @relation(fields: [administrationId], references: [id], onDelete: Cascade)
  category       Category?      @relation(fields: [categoryId], references: [id])

  @@index([administrationId])
}

// =========================================================
// SHARED TAXONOMY: Category -> MetricDefinition -> MetricValue
// =========================================================

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String
  icon        String?
  colorHex    String?
  sortOrder   Int     @default(0)

  metricDefinitions MetricDefinition[]
  campaignPromises  CampaignPromise[]
  policyAreas       PolicyArea[]
}

model MetricDefinition {
  id               String  @id @default(cuid())
  categoryId       String
  slug             String  @unique
  name             String
  description      String
  unit             String // "count" | "usd" | "percent" | "years" | "index"
  higherIsBetter   Boolean @default(true)
  decimalPrecision Int     @default(0)
  sortOrder        Int     @default(0)
  isPlaceholder    Boolean @default(true)

  calculationMethod String? // free text: how this metric is calculated
  coverageNote      String? // free text: period/jurisdiction coverage caveats
  limitations       String? // free text: known limitations of this metric
  primarySourceId   String? // canonical Source shown on the metric detail page

  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  primarySource Source?        @relation(fields: [primarySourceId], references: [id], onDelete: SetNull)
  metricValues  MetricValue[]
  researchTasks ResearchTask[]

  @@index([categoryId])
  @@index([primarySourceId])
}

model MetricValue {
  id                 String   @id @default(cuid())
  metricDefinitionId String
  jurisdictionId     String
  administrationId   String?
  sourceId           String
  periodType         String // "year" | "quarter" | "month"
  periodStart        DateTime
  periodEnd          DateTime
  periodLabel        String // "2019", "2019-Q3", display convenience
  value              Decimal  @db.Decimal(16, 4)
  // ISO 4217 code for currency-denominated metrics (MetricDefinition.unit === "currency"); meaningless
  // for non-currency units (count/percent/index/etc.) but always populated with the harmless default
  // "USD" for backward compatibility with pre-internationalization rows -- see docs/CURRENCY_AND_UNITS.md.
  // Mandate NEVER auto-converts between currencies: a GBP value stays GBP, tagged accordingly, rather
  // than being silently coerced into USD. Comparing two MetricValue rows with different currencyCodes
  // is a research decision (make an explicit, documented conversion), not something the platform does
  // for you.
  currencyCode       String   @default("USD")
  confidence         String? // "high" | "estimated" | "modeled"
  notes              String?
  ingestionMethod    String   @default("seed") // "seed" | "csv" | "api" | "manual"
  dataQuality        String   @default("placeholder") // government|academic|alternative|estimated|unavailable|placeholder ("official" is a legacy value on old rows only — never used for new data, see shared/src/types/pipeline.ts::DATA_QUALITY_LEVELS)
  isPlaceholder      Boolean  @default(true)

  // Research Passport fields (see docs/MANDATE_OPERATING_SYSTEM.md) -- all optional/additive so
  // existing rows are unaffected. Populated going forward as real per-person attribution and
  // methodology versioning come online; NULL simply means "not yet captured," not an error.
  researchedById     String?
  reviewedById       String?
  reviewedAt         DateTime?
  methodologyVersion String? // the METHODOLOGY_VERSIONS entry (shared/src/types/methodology.ts) in effect when this value was researched
  nextReviewDate     DateTime? // when this value should be re-checked against fresher source data; NULL = not yet scheduled

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  metricDefinition MetricDefinition @relation(fields: [metricDefinitionId], references: [id], onDelete: Restrict)
  jurisdiction     Jurisdiction     @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
  administration   Administration?  @relation(fields: [administrationId], references: [id], onDelete: SetNull)
  source           Source           @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  researchedBy     User?            @relation("ResearchedByOnMetricValue", fields: [researchedById], references: [id], onDelete: SetNull)
  reviewedBy       User?            @relation("ReviewedByOnMetricValue", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([metricDefinitionId, jurisdictionId, periodType, periodStart])
  @@index([jurisdictionId, periodStart])
  @@index([metricDefinitionId, jurisdictionId])
  @@index([administrationId])
  @@index([nextReviewDate])
}

// =========================================================
// SOURCE / ATTRIBUTION (first-class, linkable from any metric value)
// =========================================================

model Source {
  id            String    @id @default(cuid())
  name          String    @unique
  publisher     String?
  url           String?
  sourceType    String // "government_dataset" | "government_report" | "academic" | "news" | "financial_data" | "placeholder"
  citation      String?
  retrievedAt   DateTime?
  isPlaceholder Boolean   @default(true)
  createdAt     DateTime  @default(now())

  publicationDate   DateTime? // vintage/publication date of the cited dataset
  updateFrequency   String? // "annual" | "quarterly" | "monthly" | "one_time"
  methodology       String? // free text: how the source org collects/calculates this data
  defaultConfidence String? // "high" | "estimated" | "modeled" fallback for MetricValue.confidence

  // Internationalization fields -- see docs/INTERNATIONAL_SOURCE_HIERARCHY.md. Both nullable/optional
  // so every existing US source row (country implicitly US, language implicitly English) needs no
  // backfill: NULL country/language means "not yet recorded," not "domestic"/"English" by inference.
  country  String? // ISO-3166-ish country name the PUBLISHER belongs to (e.g. "United Kingdom", "Singapore") -- not the jurisdiction the data is ABOUT, which can differ (e.g. an OECD source covering many countries)
  language String? // BCP-47-ish language code the source is published in (e.g. "en", "ja", "ko") -- NULL means not yet recorded, not assumed English

  metricValues      MetricValue[]
  metricDefinitions MetricDefinition[]
  timelineEvents    TimelineEvent[]
  evidenceLinks     EvidenceLink[]
  legislation       SupportingLegislation[]

  @@index([sourceType])
}

// =========================================================
// TIMELINE (reused across GovernanceModel / Jurisdiction / Administration)
// =========================================================

model TimelineEvent {
  id                String   @id @default(cuid())
  governanceModelId String?
  jurisdictionId    String?
  administrationId  String?
  eventDate         DateTime
  title             String
  description       String
  eventType         String // "election" | "legislation" | "program_launch" | "milestone"
  sourceId          String?
  isPlaceholder     Boolean  @default(true)

  governanceModel GovernanceModel? @relation(fields: [governanceModelId], references: [id], onDelete: Cascade)
  jurisdiction    Jurisdiction?    @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
  administration  Administration?  @relation(fields: [administrationId], references: [id], onDelete: Cascade)
  source          Source?          @relation(fields: [sourceId], references: [id])

  @@index([governanceModelId])
  @@index([jurisdictionId])
  @@index([administrationId])
  @@index([eventDate])
}

// =========================================================
// INSTITUTIONAL PIPELINE TRACKER (lightweight stub for future full build)
// =========================================================

model PolicyArea {
  id            String  @id @default(cuid())
  categoryId    String?
  slug          String  @unique
  name          String
  description   String
  sortOrder     Int     @default(0)
  isPlaceholder Boolean @default(true)

  category      Category?            @relation(fields: [categoryId], references: [id])
  assessments   PipelineAssessment[]
  researchTasks ResearchTask[]

  @@index([categoryId])
}

model PipelineAssessment {
  id               String   @id @default(cuid())
  jurisdictionId   String
  policyAreaId     String
  administrationId String?
  // Distinguishes MULTIPLE institutions that can address the same policy area (see
  // docs/INSTITUTIONAL_PIPELINE_ARCHITECTURE.md -- e.g. Greater Manchester's affordable-housing
  // capacity rests on at least three real institutions: GMHILF, the Brownfield Fund, and Places for
  // Everyone). Default "" means "the single/primary institution for this policy area, not otherwise
  // distinguished" -- the behavior every existing row (Chicago's 25, Greater Manchester's 10) already
  // has, unchanged by this field's addition. A non-empty value opts a row into being tracked as one
  // of several named institutions within the same policy area, each with its own independent
  // isCurrent history. Deliberately a plain string, not a separate Institution model -- see the
  // architecture doc for why a full Institution/Program/GovernanceMechanism model was NOT built.
  institutionName  String   @default("")
  stage            Int // 0-5: see PIPELINE_STAGE_DEFINITIONS in shared/src/types/pipeline.ts
  dataQuality      String   @default("placeholder") // same vocabulary as MetricValue.dataQuality: government|academic|alternative|estimated|unavailable|placeholder
  assessmentDate   DateTime
  isCurrent        Boolean  @default(true)
  timelineNotes    String?
  evidenceSummary  String?
  limitations      String?
  isPlaceholder    Boolean  @default(true)

  // Research Passport fields (see docs/MANDATE_OPERATING_SYSTEM.md) -- all optional/additive so
  // existing rows are unaffected.
  researchedById     String?
  reviewedById       String?
  reviewedAt         DateTime?
  methodologyVersion String? // the METHODOLOGY_VERSIONS entry (shared/src/types/methodology.ts) in effect when this assessment was made
  nextReviewDate     DateTime? // when this assessment should be re-checked; NULL = not yet scheduled

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jurisdiction   Jurisdiction            @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
  policyArea     PolicyArea              @relation(fields: [policyAreaId], references: [id], onDelete: Cascade)
  administration Administration?         @relation(fields: [administrationId], references: [id], onDelete: SetNull)
  legislation    SupportingLegislation[]
  evidenceLinks  EvidenceLink[]
  researchedBy   User?                   @relation("ResearchedByOnAssessment", fields: [researchedById], references: [id], onDelete: SetNull)
  reviewedBy     User?                   @relation("ReviewedByOnAssessment", fields: [reviewedById], references: [id], onDelete: SetNull)

  // Prevents literal duplicate assessments for the same (jurisdiction, policyArea, institution) on
  // the same date — both a data-integrity backstop for the admin write path and what makes reseeding
  // the hardcoded researched-pipeline seed data idempotent (create-if-missing instead of blind create
  // on every run). Including institutionName is what allows multiple concurrently-current
  // institutions per policy area (see the field comment above) without each one's history colliding
  // with another's.
  @@unique([jurisdictionId, policyAreaId, institutionName, assessmentDate])
  @@index([jurisdictionId, policyAreaId, institutionName, assessmentDate])
  @@index([isCurrent])
  @@index([nextReviewDate])
}

model SupportingLegislation {
  id                   String    @id @default(cuid())
  pipelineAssessmentId String
  title                String
  billNumber           String?
  status               String? // "proposed" | "passed" | "enacted"
  dateEnacted          DateTime?
  url                  String?
  sourceId             String?
  isPlaceholder        Boolean   @default(true)

  pipelineAssessment PipelineAssessment @relation(fields: [pipelineAssessmentId], references: [id], onDelete: Cascade)
  source             Source?            @relation(fields: [sourceId], references: [id])

  @@index([pipelineAssessmentId])
}

model EvidenceLink {
  id                   String    @id @default(cuid())
  pipelineAssessmentId String
  label                String
  description          String?
  url                  String
  evidenceType         String // "dataset" | "article" | "legislation_text" | "report"
  publicationDate      DateTime?
  publisher            String? // organization/publisher, independent of a linked Source registry entry
  sourceTier           String? // "government" | "academic" | "alternative" (Tier 1/2/3) - describes evidence that exists, unlike PipelineAssessment.dataQuality
  sourceId             String?
  isPlaceholder        Boolean   @default(true)

  pipelineAssessment PipelineAssessment @relation(fields: [pipelineAssessmentId], references: [id], onDelete: Cascade)
  source             Source?            @relation(fields: [sourceId], references: [id])

  @@index([pipelineAssessmentId])
}

// =========================================================
// RESEARCH QUEUE (lightweight "what should I work on next" tracker for a
// distributed research team — deliberately not a project-management system)
// =========================================================

model ResearchTask {
  id  String @id @default(cuid())
  // Stable key used only by the seed script to upsert without duplicating or resetting a
  // researcher's progress on reseed (see server/prisma/seed/data/researchQueue.ts) — never shown
  // in the UI.
  key String @unique

  jurisdictionId     String
  policyAreaId       String? // set when taskType is "pipeline_assessment"
  metricDefinitionId String? // set when taskType is "metric"
  taskType           String // "metric" | "pipeline_assessment"

  researchQuestion String // free text: exactly what needs to be researched, and why it matters
  priority         Int    @default(3) // 1 (highest) - 5 (lowest), matches the research roadmap's ranking

  status               String  @default("unassigned") // unassigned | in_progress | awaiting_review | changes_requested | complete | unavailable
  assignedResearcher   String? // legacy free text name/email, kept for continuity with pre-User-model tasks; prefer assignedResearcherId once a real User row exists
  assignedResearcherId String? // FK to User -- the structured replacement for assignedResearcher
  reviewerId           String? // FK to User -- who is/was responsible for reviewing this task's output; distinct from "the founder by default" documented in docs/DECISION_OWNERSHIP.md
  sourceStatus         String? // free text progress note, e.g. "Tier 1 source identified, not yet pulled"
  notes                String?

  revisionCount      Int       @default(0) // incremented each time a reviewer sends work back for changes
  methodologyVersion String? // the METHODOLOGY_VERSIONS entry this task should be researched under (shared/src/types/methodology.ts)
  dueDate            DateTime? // optional soft target for completion
  nextReviewDate     DateTime? // when the resulting research should next be revisited, once complete

  // Formal submit -> review -> accept/revise workflow (see docs/RESEARCH_MAP.md). submittedAt is
  // stamped automatically whenever status transitions to "awaiting_review" (researchTask.service.ts);
  // reviewedAt/reviewNotes are set by the explicit accept/request-revision actions, not the generic
  // status PATCH, so "submitted" and "reviewed" are never conflated.
  submittedAt DateTime?
  reviewedAt  DateTime?
  reviewNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jurisdiction           Jurisdiction      @relation(fields: [jurisdictionId], references: [id], onDelete: Cascade)
  policyArea             PolicyArea?       @relation(fields: [policyAreaId], references: [id], onDelete: SetNull)
  metricDefinition       MetricDefinition? @relation(fields: [metricDefinitionId], references: [id], onDelete: SetNull)
  assignedResearcherUser User?             @relation("AssignedResearcher", fields: [assignedResearcherId], references: [id], onDelete: SetNull)
  reviewer               User?             @relation("ReviewerOnTask", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([jurisdictionId])
  @@index([assignedResearcherId])
  @@index([reviewerId])
}

// =========================================================
// EXTERNAL CONTRIBUTION (lightweight submit -> internal review workflow for
// people outside the internal research organization -- professors, other
// researchers, practitioners, journalists. See docs/MANDATE_RESEARCH_NETWORK.md,
// "External Contribution System". Deliberately a single flat table, not a
// peer-review platform: one row per submission, reviewed by an internal User,
// never auto-incorporated into production data.
// =========================================================

model ExternalContribution {
  id String @id @default(cuid())

  contributorName        String
  contributorEmail       String?
  contributorAffiliation String? // free text org, e.g. "NYU", "Brookings Institution" -- independent of contributorUserId below
  contributorUserId      String? // set only if this person already has a User roster row (affiliation: external); most submitters won't

  contributionType String // methodological_critique | dataset | academic_research | policy_analysis | expert_commentary | source_recommendation | data_correction | report_review
  topic            String
  jurisdictionId   String?

  description                 String
  evidenceUrl                 String? // link to the dataset/paper/article being submitted, if any
  relationToExistingResearch  String? // free text: how this challenges, extends, or relates to current Mandate research
  limitations                 String?

  status      String    @default("submitted") // submitted | under_review | accepted | rejected | incorporated | cited
  reviewerId  String?
  reviewNotes String?
  reviewedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jurisdiction    Jurisdiction? @relation(fields: [jurisdictionId], references: [id], onDelete: SetNull)
  contributorUser User?        @relation("ContributorOnExternalContribution", fields: [contributorUserId], references: [id], onDelete: SetNull)
  reviewer        User?        @relation("ReviewerOnExternalContribution", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([jurisdictionId])
  @@index([contributorUserId])
}

// =========================================================
// DATA IMPORT SYSTEM (CSV / JSON / manual script / API ingestion)
// =========================================================

model ImportJob {
  id           String    @id @default(cuid())
  filename     String
  importType   String // "csv" | "json" | "manual" | "api"
  categorySlug String?
  status       String // "previewed" | "completed" | "failed" | "rolled_back"
  totalRows    Int       @default(0)
  validRows    Int       @default(0)
  invalidRows  Int       @default(0)
  createdCount Int       @default(0)
  updatedCount Int       @default(0)
  errorSummary String?
  triggeredBy  String? // "cli" | "admin:<identifier>"
  createdAt    DateTime  @default(now())
  completedAt  DateTime?
  rolledBackAt DateTime?
  restoredAt   DateTime? // set if a rollback of this job was itself undone (see rollback.ts::undoRollback)

  rows ImportRowResult[]

  @@index([status])
  @@index([createdAt])
}

model ImportRowResult {
  id                String  @id @default(cuid())
  importJobId       String
  rowNumber         Int
  status            String // "created" | "updated" | "skipped" | "rejected"
  message           String?
  metricValueId     String?
  previousValueJson String? // JSON snapshot of the prior MetricValue, for rollback of updates
  restoreValueJson  String? // JSON snapshot captured AT ROLLBACK TIME of whatever the rollback is about to overwrite/delete, so the rollback itself can be undone (see rollback.ts::undoRollback)
  rawData           String // JSON of the input row, for audit

  importJob ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId])
}
